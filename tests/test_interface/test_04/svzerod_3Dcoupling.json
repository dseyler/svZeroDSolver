{
  "_comment": "Minimal coupled fixture for validating the analytical dP/dQ entry point against FD probing. One FLOW external_solver_coupling_block (mimics svMP supplying Q at endo_lv) feeds a single BloodVessel resistor R=100, terminated by a PressureReferenceBC at P=0. For this purely-resistive topology, dP/dQ at the coupled inlet equals R exactly — a closed-form ground truth that complements the analytical-vs-FD comparison in main.cpp.",
  "simulation_parameters": {
    "coupled_simulation": true,
    "number_of_time_pts": 2,
    "output_all_cycles": true,
    "steady_initial": false,
    "absolute_tolerance": 1e-12,
    "maximum_nonlinear_iterations": 30
  },
  "boundary_conditions": [
    {
      "bc_name": "BC_outlet",
      "bc_type": "PRESSURE",
      "bc_values": {
        "P": [0.0, 0.0],
        "t": [0.0, 1.0]
      }
    }
  ],
  "external_solver_coupling_blocks": [
    {
      "name": "FLOW_inlet",
      "type": "FLOW",
      "location": "inlet",
      "connected_block": "vessel0",
      "values": {
        "Q": [1.0, 1.0],
        "t": [0.0, 1.0]
      }
    }
  ],
  "junctions": [],
  "vessels": [
    {
      "boundary_conditions": {
        "outlet": "BC_outlet"
      },
      "vessel_id": 0,
      "vessel_length": 10.0,
      "vessel_name": "vessel0",
      "zero_d_element_type": "BloodVessel",
      "zero_d_element_values": {
        "R_poiseuille": 100.0,
        "C": 0.0,
        "L": 0.0,
        "stenosis_coefficient": 0.0
      }
    }
  ]
}
